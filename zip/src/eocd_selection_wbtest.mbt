    b"\x08\x00\x1a\x52\x71\x5d\x6e\xd8\xe7\x8d\x0f\x00\x00\x00\x0d\x00\x00\x00\x0e\x00\x00\x00\x64\x69\x72\x2f\x73\x65\x63\x6f\x6e\x64" +
    b"\x2e\x74\x78\x74\x2b\x4e\x4d\xce\xcf\x4b\x51\x48\xcd\x2b\x29\xaa\xe4\x02\x00\x50\x4b\x01\x02\x14\x03\x14\x00\x00\x00\x08\x00\x1a" +
    b"\x52\x71\x5d\xbc\x9e\x9d\x2e\x11\x00\x00\x00\xf0\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\x01\x00\x00\x00" +
    b"\x00\x68\x65\x6c\x6c\x6f\x2e\x74\x78\x74\x50\x4b\x01\x02\x14\x03\x14\x00\x00\x00\x08\x00\x1a\x52\x71\x5d\x6e\xd8\xe7\x8d\x0f\x00" +
    b"\x00\x00\x0d\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\x01\x38\x00\x00\x00\x64\x69\x72\x2f\x73\x65\x63\x6f" +
    b"\x6e\x64\x2e\x74\x78\x74\x50\x4b\x05\x06\x00\x00\x00\x00\x02\x00\x02\x00\x73\x00\x00\x00\x73\x00\x00\x00\x00\x00"
  let expected = [
    ("hello.txt", b"hello world\n".repeat(20)),
    ("dir/second.txt", b"second entry\n"),
  ]
  let archive = read_all(bytes)
  let directory = listing(bytes)
  assert_eq(archive.entries().length(), 2)
  assert_eq(directory.entries().length(), 2)
  for i, (name, data) in expected {
    assert_eq(archive.entries()[i].name(), name)
    assert_eq(archive.entries()[i].data(), data[:])
    assert_eq(directory.entries()[i].name(), name)
    assert_eq(read_member(bytes, directory, i, 3), data)
  }
}

