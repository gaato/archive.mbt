// Matrix bytes from the supplied APPNOTE/ten-reader survey (2026-11-17).

///|
test "EOCD fallback: classic must pass the directory signature probe after ZIP64 fails" {
  let bytes = @buffer.Buffer()
  bytes.write_uint_le(CENTRAL_HEADER_SIG)
  bytes.write_bytes(Bytes::make(72, 0))
  // Classic claims [76, 158) as its directory: this signature record is
  // well-framed there, but it is not a central-directory file header.
  bytes.write_uint_le(DIRECTORY_SIGNATURE_SIG)
  bytes.write_uint16_le((76).to_uint16())
  assert_eq(bytes.length(), 82)
  // ZIP64 claims [0, 82), passing the selection signature probe. With zero
  // entries its full directory parse instead expects a digital signature.
  bytes.write_uint_le(ZIP64_EOCD_SIG)
  bytes.write_uint64_le(44UL)
  bytes.write_uint16_le((45).to_uint16())
  bytes.write_uint16_le((45).to_uint16())
  bytes.write_uint_le(0U)
  bytes.write_uint_le(0U)
  bytes.write_uint64_le(0UL)
  bytes.write_uint64_le(0UL)
  bytes.write_uint64_le(82UL)
  bytes.write_uint64_le(0UL)
  assert_eq(bytes.length(), 138)
  bytes.write_uint_le(ZIP64_LOCATOR_SIG)
  bytes.write_uint_le(0U)
  bytes.write_uint64_le(82UL)
  bytes.write_uint_le(1U)
  assert_eq(bytes.length(), 158)
  bytes.write_bytes(classic_eocd(0, 0, 0, 0, 82, 0))
  let bytes = bytes.to_bytes()
  for read in [() => ignore(read_all(bytes)), () => ignore(listing(bytes))] {
    let ZipError(kind, message) = @test.expect_error(read)
    assert_eq(kind, InvalidSignature)
    // Both attempts fail with InvalidSignature, so check the classic error's
    // diagnostic too: the earlier ZIP64 parse reports a directory signature.
    assert_eq(message, "zip: invalid central header signature")
  }
}

///|
test "EOCD selection: two valid nonempty EOF records are Corrupt before limits" {
  let archive = Archive()
  archive.add("x", b"payload", compression=Store)
  let plain = write(archive)
  let end = find_end_of_central(plain).unwrap()
  let central = plain[end.central_offset.reinterpret_as_int():end.offset].to_owned()
  let decoy = classic_eocd(0, 0, 1, 1, central.length(), plain.length())
  archive.set_comment(central + decoy)
  let bytes = write(archive)
  expect_zip_kind(() => ignore(read_all(bytes)), Corrupt)
  expect_zip_kind(() => ignore(listing(bytes)), Corrupt)
  expect_zip_kind(
    () => ignore(read_all(bytes, limits=ReadLimits(max_entries=0))),
    Corrupt,
  )
  expect_zip_kind(
    () => ignore(directory_by_ranges(bytes, DirectoryLimits(max_entries=0UL))),
    Corrupt,
  )
  try {
    ignore(listing(bytes))
    fail("ambiguous archive accepted")
  } catch {
    ZipError(kind, message) => {
      assert_eq(kind, Corrupt)
      assert_true(
        message.contains("more than one end of central directory record"),
      )
      assert_true(message.contains("APPNOTE 4.3.1"))
    }
    error => raise error
  }
}

///|
test "EOCD selection: invalid tier 1 reports earliest error without tier 2" {
  let older = Archive()
  older.add("older", b"old", compression=Store)
  let prefix = write(older)
  let archive = Archive()
  archive.add("x", b"payload", compression=Store)
  archive.set_comment(b"PK\x05\x06" + Bytes::make(18, 0))
  let plain = write(archive)
  let end = find_end_of_central(plain).unwrap()
  let bytes = (prefix + plain).to_fixedarray()
  bytes[prefix.length() + end.central_offset.reinterpret_as_int()] = 0
  let bytes = Bytes::from_array(bytes)
  // The earlier exact candidate has a bad central signature; the later exact
  // empty candidate has a prefix gap. The older complete archive is tier 2.
  expect_zip_kind(() => ignore(read_all(bytes)), InvalidSignature)
  expect_zip_kind(() => ignore(listing(bytes)), InvalidSignature)
}

///|
test "EOCD selection: tier 2 chooses the last structurally valid record" {
  let first = Archive()
  first.add("first", b"one", compression=Store)
  let last = Archive()
  last.add("last", b"two", compression=Store)
  let bytes = write(first) + write(last) + b"trailing garbage"
  assert_eq(read_all(bytes).entries()[0].name(), "last")
  assert_eq(read_member(bytes, listing(bytes), 0, 1), b"two")
}

