      b"\x72\x6f\x70\x3a\x20\x53\x74\x6f\x72\x65\x2c\x20\x44\x65\x66\x6c\x61\x74\x65\x2c\x20\x5a\x73\x74\x61\x6e\x64\x61\x72\x64\x2e\x0a",
    ),
  ]
  let archive = @zip.read_all(bytes)
  let source = archive_range_source(bytes)
  let directory = drive_directory_ranges(
    @zip.DirectoryReader(bytes.length().to_uint64()),
    source,
  )
  assert_eq(archive.entries().length(), expected.length())
  assert_eq(directory.entries().length(), expected.length())
  for i, (name, data) in expected {
    assert_eq(archive.entries()[i].name(), name)
    assert_eq(archive.entries()[i].data(), data[:])
    assert_eq(directory.entries()[i].name(), name)
    assert_eq(drive_entry_ranges(directory.open_entry(i), source, 37), data)
  }
}

