  let bytes = b"\x50\x4b\x03\x04\x14\x00\x00\x00\x08\x00\xe6\x81\x1c\x5d\xac\x2a\x93\xd8\x04\x00\x00\x00\x02\x00\x00\x00\x05\x00\x00\x00\x61\x2e" +
    b"\x74\x78\x74\xcb\xc8\x04\x00\x50\x4b\x01\x02\x14\x03\x14\x00\x00\x00\x08\x00\xe6\x81\x1c\x5d\xac\x2a\x93\xd8\x04\x00\x00\x00\x02" +
    b"\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\x01\x00\x00\x00\x00\x61\x2e\x74\x78\x74\x50\x4b\x05\x06\x00\x00" +
    b"\x00\x00\x01\x00\x01\x00\x33\x00\x00\x00\x27\x00\x00\x00\x00\x00"
  let expected : Array[(String, Bytes)] = [("a.txt", b"\x68\x69")]
  let archive = @zip.read_all(bytes)
  let source = archive_range_source(bytes)
  let directory = drive_directory_ranges(
    @zip.DirectoryReader(bytes.length().to_uint64()),
    source,
  )
  assert_eq(archive.entries().length(), expected.length())
  assert_eq(directory.entries().length(), expected.length())
  for i, (name, data) in expected {
    assert_eq(archive.entries()[i].name(), name)
    assert_eq(archive.entries()[i].data(), data[:])
    assert_eq(directory.entries()[i].name(), name)
    assert_eq(drive_entry_ranges(directory.open_entry(i), source, 37), data)
  }
}

