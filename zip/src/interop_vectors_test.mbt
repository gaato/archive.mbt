  let expected = b"Archive interop: Store, Deflate, Zstandard.\n".repeat(32)
  let entries = [
    ("distant.bin", external_far_payload(), @zip.Deflate64),
    ("stored.txt", expected, @zip.Store),
  ]
  let archive = @zip.read_all(bytes)
  let source = archive_range_source(bytes)
  let directory = drive_directory_ranges(
    @zip.DirectoryReader(bytes.length().to_uint64()),
    source,
  )
  assert_eq(archive.entries().length(), entries.length())
  assert_eq(directory.entries().length(), entries.length())
  for i, (name, data, compression) in entries {
    assert_eq(archive.entries()[i].name(), name)
    assert_eq(archive.entries()[i].compression(), compression)
    assert_eq(archive.get(name), Some(data[:]))
    assert_eq(drive_entry_ranges(directory.open_entry(i), source, 137), data)
  }
