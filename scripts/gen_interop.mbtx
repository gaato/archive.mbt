----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/hex",
}
----

// Rebuild external ZIP fixtures, their SHA-256 manifest and portable tests.
// --check verifies the committed hashes and generated test source without
// requiring the producer versions that made the binary fixtures.

let payload : Bytes = b"Archive interop: Store, Deflate, Zstandard.\n".repeat(32)

// A 48 KiB noise block repeated three times requires the extended history
// for useful matches. The token walker below verifies the actual distances.
fn far_payload() -> Bytes {
  let mut state = 9U
  let block = Bytes::makei(49152, _ => {
    state = state * 1664525U + 1013904223U
    (state >> 24).to_byte()
  })
  block + block + block
}

fn u16(bytes : Bytes, at : Int32) -> Int32 {
  bytes[at].to_int() | (bytes[at + 1].to_int() << 8)
}

fn u32(bytes : Bytes, at : Int32) -> Int32 {
  u16(bytes, at) | (u16(bytes, at + 2) << 16)
}

fn raw_entry(bytes : Bytes, name : String, method_id : Int32) -> Bytes {
  let end = bytes.length() - 22
  guard u32(bytes, end) == 0x06054b50 else { abort("generated ZIP must have no comment") }
  let mut at = u32(bytes, end + 16)
  for _ in 0..<u16(bytes, end + 10) {
    guard u32(bytes, at) == 0x02014b50 else { abort("generated ZIP directory") }
    let n = u16(bytes, at + 28)
    let found = @hex.encode(bytes[at + 46:at + 46 + n])
    // All generated names are ASCII.
    let wanted = @hex.encode(Bytes::makei(name.length(), i => name[i].to_int().to_byte()))
    if found == wanted {
      guard u16(bytes, at + 10) == method_id else { abort("7z selected a different compression method") }
      let header = u32(bytes, at + 42)
      let start = header + 30 + u16(bytes, header + 26) + u16(bytes, header + 28)
      return bytes[start:start + u32(bytes, at + 20)].to_owned()
    }
    at += 46 + n + u16(bytes, at + 30) + u16(bytes, at + 32)
  }
  abort("generated ZIP member missing")
}

struct Bits {
  bytes : Bytes
  mut position : Int32
}

fn Bits::take(self : Bits, count : Int32) -> Int32 {
  let mut value = 0
  for bit in 0..<count {
    guard self.position < self.bytes.length() * 8 else { abort("truncated fixture bits") }
    value = value | (((self.bytes[self.position / 8].to_int() >> (self.position % 8)) & 1) << bit)
    self.position += 1
  }
  value
}

fn codes(lengths : Array[Int32]) -> Map[Int32, Int32] {
  let counts = Array::make(16, 0)
  for length in lengths { counts[length] += 1 }
  counts[0] = 0
  let next = Array::make(16, 0)
  for length in 1..<16 { next[length] = (next[length - 1] + counts[length - 1]) << 1 }
  let table : Map[Int32, Int32] = Map([])
  for symbol, length in lengths {
    if length > 0 {
      table[(length << 16) | next[length]] = symbol
      next[length] += 1
    }
  }
  table
}

fn Bits::symbol(self : Bits, table : Map[Int32, Int32]) -> Int32 {
  let mut code = 0
  for length in 1..<16 {
    code = (code << 1) | self.take(1)
    if table.get((length << 16) | code) is Some(symbol) { return symbol }
  }
  abort("invalid fixture Huffman symbol")
}

// Independent format-level inspection, not the gaato decoder under test.
// Returns (largest distance, decoded size), without allocating decoded output.
fn deflate64_shape(raw : Bytes) -> (Int32, Int32) {
  let bits = { bytes: raw, position: 0 }
  let mut size = 0
  let mut maximum = 0
  for ;; {
    let last_block = bits.take(1) == 1
    let kind = bits.take(2)
    if kind == 0 {
      bits.position = (bits.position + 7) / 8 * 8
      let length = bits.take(16)
      guard bits.take(16) == (length ^ 65535) else { abort("fixture stored length") }
      bits.position += length * 8
      guard bits.position <= raw.length() * 8 else { abort("fixture stored block") }
      size += length
    } else {
      guard kind != 3 else { abort("fixture block type") }
      let (lit, dist) = if kind == 1 {
        (codes(Array::makei(288, i => if i < 144 { 8 } else if i < 256 { 9 } else if i < 280 { 7 } else { 8 })), codes(Array::make(32, 5)))
      } else {
        let literals = bits.take(5) + 257
        let distances = bits.take(5) + 1
        let count = bits.take(4) + 4
        let order = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
        let lengths = Array::make(19, 0)
        for i in 0..<count { lengths[order[i]] = bits.take(3) }
        let table = codes(lengths)
        let all : Array[Int32] = []
        while all.length() < literals + distances {
          let symbol = bits.symbol(table)
          match symbol {
            0..=15 => all.push(symbol)
            16 => {
              let previous = all.last().unwrap()
              for _ in 0..<(bits.take(2) + 3) { all.push(previous) }
            }
            17 => for _ in 0..<(bits.take(3) + 3) { all.push(0) }
            _ => for _ in 0..<(bits.take(7) + 11) { all.push(0) }
          }
        }
        (codes(all[:literals].to_owned()), codes(all[literals:].to_owned()))
      }
      for ;; {
        let symbol = bits.symbol(lit)
        if symbol == 256 { break }
        if symbol < 256 { size += 1; continue }
        guard symbol <= 285 else { abort("fixture length code") }
        let length = if symbol == 285 { 3 + bits.take(16) } else if symbol < 265 { symbol - 254 } else {
          let extra = (symbol - 261) / 4
          3 + ((4 + (symbol - 265) % 4) << extra) + bits.take(extra)
        }
        let symbol = bits.symbol(dist)
        let distance = if symbol < 4 { symbol + 1 } else {
          let extra = symbol / 2 - 1
          1 + ((2 + symbol % 2) << extra) + bits.take(extra)
        }
        guard distance <= size else { abort("fixture distance before history") }
        maximum = maximum.max(distance)
        size += length
      }
    }
    if last_block { break }
  }
  (maximum, size)
}

async fn verify_deflate64(files : Array[String]) -> Unit {
  for name in files {
    if !name.has_prefix("7zip-deflate64") { continue }
    let bytes = @fs.read_binary("zip/testdata/\{name}")
    if name == "7zip-deflate64.zip" {
      ignore(raw_entry(bytes, "payload.txt", 9))
    } else {
      let (distance, size) = deflate64_shape(raw_entry(bytes, "distant.bin", 9))
      guard size == far_payload().length() && size > 65536 && distance > 32768 else {
        fail("\{name}: expected >64 KiB and a distance past 32 KiB, got size=\{size}, distance=\{distance}")
      }
      if name == "7zip-deflate64-mixed.zip" { ignore(raw_entry(bytes, "stored.txt", 0)) }
      println("\{name}: decoded size \{size}, maximum match distance \{distance}")
    }
  }
}

let python_zip : String =
  #|import sys,zipfile
  #|info=zipfile.ZipInfo('payload.txt',(2020,1,2,3,4,6))
  #|info.compress_type=int(sys.argv[2])
  #|info.external_attr=0o100644 << 16
  #|with zipfile.ZipFile(sys.argv[1],'w') as z:
  #|    z.writestr(info,sys.stdin.buffer.read(),compresslevel=6)

async fn python() -> String {
  for program in ["python3.14", "python3"] {
    try {
      @shell.Cmd(program, ["-I", "-c", "import zipfile"]).output().check()
      return program
    } catch { _ => () }
  }
  fail("Python zipfile is required")
}

async fn sha256(program : String, path : String) -> String {
  let result = @shell.Cmd(program, ["-I", "-c", "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())", path]).output()
  result.check()
  result.stdout().trim().to_owned()
}

fn literal(bytes : Bytes) -> String {
  let lines : Array[String] = []
  for start = 0; start < bytes.length(); start = start + 32 {
    let hex = @hex.encode(bytes[start:(start + 32).min(bytes.length())])
    let parts = []
    for i = 0; i < hex.length(); i = i + 2 {
      parts.push("\\x" + hex[i:i + 2].to_owned())
    }
    lines.push("  b\"" + parts.join("") + "\"")
  }
  // A long left-associated expression exhausts V8's parser stack before the
  // tests run. A balanced tree also avoids quadratic copying of large pins.
  let mut parts = lines
  while parts.length() > 1 {
    let previous = parts
    parts = Array::makei((previous.length() + 1) / 2, i => {
      let at = i * 2
      if at + 1 < previous.length() {
        "(" + previous[at] + " +\n" + previous[at + 1] + ")"
      } else { previous[at] }
    })
  }
  parts[0]
}

async fn source(files : Array[String]) -> String {
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by scripts/gen_interop.mbtx from zip/testdata; SHA256SUMS records provenance.\n")
  out.write_string("\n///|\nfn external_far_payload() -> Bytes {\nlet mut state = 9U\nlet block = Bytes::makei(49152, _ => { state = state * 1664525U + 1013904223U; (state >> 24).to_byte() })\nblock + block + block\n}\n")
  for name in files {
    let bytes = @fs.read_binary("zip/testdata/\{name}")
    let compression = if name.has_prefix("7zip-deflate64") { "@zip.Deflate64" } else if name.contains("store") { "@zip.Store" } else if name.contains("zstd") { "@zip.Zstandard" } else { "@zip.Deflate" }
    let entries = if name == "7zip-deflate64-window.zip" { "[(\"distant.bin\", expected, @zip.Deflate64)]" } else if name == "7zip-deflate64-mixed.zip" { "[(\"distant.bin\", external_far_payload(), @zip.Deflate64), (\"stored.txt\", expected, @zip.Store)]" } else {
      "[(\"payload.txt\", expected, \{compression})]"
    }
    let chunk = if name.contains("window") || name.contains("mixed") { 137 } else { 1 }
    let expected = if name == "7zip-deflate64-window.zip" { "external_far_payload()" } else { "b\"Archive interop: Store, Deflate, Zstandard.\\n\".repeat(32)" }
    out.write_string("\n///|\ntest \"external ZIP: \{name}\" {\n  let bytes =\n\{literal(bytes)}\n  let expected = \{expected}\n  let entries = \{entries}\n  let archive = @zip.read_all(bytes)\n  let source = archive_range_source(bytes)\n  let directory = drive_directory_ranges(@zip.DirectoryReader(bytes.length().to_uint64()), source)\n  assert_eq(archive.entries().length(), entries.length())\n  assert_eq(directory.entries().length(), entries.length())\n  for i, (name, data, compression) in entries {\n  assert_eq(archive.entries()[i].name(), name)\n  assert_eq(archive.entries()[i].compression(), compression)\n  assert_eq(archive.get(name), Some(data[:]))\n  assert_eq(drive_entry_ranges(directory.open_entry(i), source, \{chunk}), data)\n  }\n}\n")
  }
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(max_output_bytes=1 << 24)
  formatted.check()
  formatted.stdout()
}

async fn main {
  let program = python()
  if @env.args()[1:].contains("--check") {
    let files : Array[String] = []
    for line in @fs.read_text("zip/testdata/SHA256SUMS").split("\n") {
      if line.split("  ").to_array() is [expected, name] {
        guard name.has_suffix(".zip") && !name.contains("/") else { fail("unsafe fixture name") }
        guard sha256(program, "zip/testdata/\{name}") == expected.to_owned() else { fail("SHA-256 mismatch: \{name}") }
        files.push(name.to_owned())
      }
    }
    guard !files.is_empty() else { fail("empty fixture manifest") }
    verify_deflate64(files)
    guard source(files) == @fs.read_text("zip/src/interop_vectors_test.mbt") else { fail("stale embedded interop fixtures: run generator") }
    println("interop fixture hashes and embedded tests: OK (\{files.length()})")
    return
  }
  for dir in ["zip/testdata", "_build/interop-generation"] {
    if !@fs.exists(dir) { @fs.mkdir(dir, recursive=true) }
  }
  let directory = "_build/interop-generation"
  let file = "\{directory}/payload.txt"
  @fs.write_binary(file, payload)
  @fs.chmod(file, 0o644)
  @shell.Cmd("touch", ["-t", "202001020304.06", file], env={"TZ": "UTC"}).run()
  let produced : Array[String] = []
  let notes : Array[String] = []
  let version = @shell.Cmd(program, ["--version"]).output()
  notes.push(version.stdout().trim().to_owned())
  let supports_zstd = @shell.Cmd(program, ["-I", "-c", "import zipfile; raise SystemExit(0 if hasattr(zipfile,'ZIP_ZSTANDARD') else 1)"]).status() == 0
  for (name, code) in [("python-store.zip", "0"), ("python-deflate.zip", "8"), ("python-zstd.zip", "93")] {
    if code == "93" && !supports_zstd { notes.push("SKIP Python Zstandard: zipfile has no ZIP_ZSTANDARD"); continue }
    let path = "\{directory}/\{name}"
    @shell.Cmd(program, ["-I", "-c", python_zip, path, code], stdin=Binary(payload)).run()
    @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
    produced.push(name)
  }
  let zip_available = try { @shell.Cmd("zip", ["-v"]).output().check(); true } catch { _ => false }
  if zip_available {
    for (name, flags) in [("infozip-store.zip", "-0"), ("infozip-deflate.zip", "-9")] {
      let path = "\{directory}/\{name}"
      if @fs.exists(path) { @fs.remove(path) }
      let result = @shell.Cmd("zip", ["-X", "-D", "-q", flags, name, "payload.txt"], cwd=directory, env={"TZ": "UTC"}).output()
      result.check()
      @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
      produced.push(name)
    }
    notes.push(@shell.Cmd("zip", ["-v"]).output().stdout())
  } else { notes.push("SKIP Info-ZIP: zip command absent") }
  let seven = try { Some(@shell.Cmd("7z", ["i"]).output()) } catch { _ => None }
  if seven is Some(info) {
    info.check()
    notes.push(info.stdout())
    let zstd = info.stdout().split("\n").any(line => line.contains("ZSTD") || line.contains("Zstd"))
    for (name, codec_name) in [("7zip-deflate.zip", "Deflate"), ("7zip-zstd.zip", "ZSTD"), ("7zip-deflate64.zip", "Deflate64")] {
      if codec_name == "ZSTD" && !zstd { notes.push("SKIP 7-Zip Zstandard encoding: 7z i lists no ZSTD encoder"); continue }
      let path = "\{directory}/\{name}"
      if @fs.exists(path) { @fs.remove(path) }
      @shell.Cmd("7z", ["a", "-tzip", "-mm=\{codec_name}", "-mtc=off", "-mta=off", "-mtm=off", "-mmt=1", name, "payload.txt"], cwd=directory, env={"TZ": "UTC"}, stdout=Discard).run()
      @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
      produced.push(name)
    }
    for (name, data) in [("distant.bin", far_payload()), ("stored.txt", payload)] {
      @fs.write_binary("\{directory}/\{name}", data)
      @fs.chmod("\{directory}/\{name}", 0o644)
      @shell.Cmd("touch", ["-t", "202001020304.06", "\{directory}/\{name}"], env={"TZ": "UTC"}).run()
    }
    for name in ["7zip-deflate64-window.zip", "7zip-deflate64-mixed.zip"] {
      let path = "\{directory}/\{name}"
      if @fs.exists(path) { @fs.remove(path) }
      let options = ["a", "-tzip", "-mtc=off", "-mta=off", "-mtm=off", "-mmt=1"]
      if name.contains("mixed") {
        @shell.Cmd("7z", [..options, "-mm=Copy", name, "stored.txt"], cwd=directory, env={"TZ": "UTC"}, stdout=Discard).run()
      }
      @shell.Cmd("7z", [..options, "-mm=Deflate64", "-mx=9", name, "distant.bin"], cwd=directory, env={"TZ": "UTC"}, stdout=Discard).run()
      @shell.Cmd("7z", ["t", path], stdout=Discard).run()
      let back = @shell.Cmd("7z", ["x", "-so", path, "distant.bin"]).output(max_output_bytes=1 << 20)
      back.check()
      guard back.stdout_bytes() == far_payload() else { fail("7-Zip Deflate64 contents differ") }
      if name.contains("mixed") {
        let stored = @shell.Cmd("7z", ["x", "-so", path, "stored.txt"]).output()
        stored.check()
        guard stored.stdout_bytes() == payload else { fail("7-Zip stored contents differ") }
      }
      @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
      produced.push(name)
    }
  } else { fail("7-Zip is required to regenerate Deflate64 fixtures") }
  verify_deflate64(produced)
  let manifest : Array[String] = []
  for name in produced { manifest.push("\{sha256(program, "zip/testdata/\{name}")}  \{name}") }
  @fs.write_text("zip/testdata/SHA256SUMS", manifest.join("\n") + "\n")
  @fs.write_text("zip/testdata/PRODUCERS.txt", notes.join("\n") + "\n")
  @fs.write_text("zip/src/interop_vectors_test.mbt", source(produced))
  println("generated \{produced.length()} external ZIP fixtures")
}
