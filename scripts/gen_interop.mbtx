----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/hex",
}
----

// Rebuild external ZIP fixtures, their SHA-256 manifest and portable tests.
// --check verifies the committed hashes and generated test source without
// requiring the producer versions that made the binary fixtures.

let payload : Bytes = b"Archive interop: Store, Deflate, Zstandard.\n".repeat(32)

let python_zip : String =
  #|import sys,zipfile
  #|info=zipfile.ZipInfo('payload.txt',(2020,1,2,3,4,6))
  #|info.compress_type=int(sys.argv[2])
  #|info.external_attr=0o100644 << 16
  #|with zipfile.ZipFile(sys.argv[1],'w') as z:
  #|    z.writestr(info,sys.stdin.buffer.read(),compresslevel=6)

async fn python() -> String {
  for program in ["python3.14", "python3"] {
    try {
      @shell.Cmd(program, ["-I", "-c", "import zipfile"]).output().check()
      return program
    } catch { _ => () }
  }
  fail("Python zipfile is required")
}

async fn sha256(program : String, path : String) -> String {
  let result = @shell.Cmd(program, ["-I", "-c", "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())", path]).output()
  result.check()
  result.stdout().trim().to_owned()
}

fn literal(bytes : Bytes) -> String {
  let lines : Array[String] = []
  for start = 0; start < bytes.length(); start = start + 32 {
    let hex = @hex.encode(bytes[start:(start + 32).min(bytes.length())])
    let parts = []
    for i = 0; i < hex.length(); i = i + 2 {
      parts.push("\\x" + hex[i:i + 2].to_owned())
    }
    lines.push("  b\"" + parts.join("") + "\"")
  }
  lines.join(" +\n")
}

async fn source(files : Array[String]) -> String {
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by scripts/gen_interop.mbtx from zip/testdata; SHA256SUMS records provenance.\n")
  for name in files {
    let bytes = @fs.read_binary("zip/testdata/\{name}")
    out.write_string("\n///|\ntest \"external ZIP: \{name}\" {\n  let bytes =\n\{literal(bytes)}\n  let expected = b\"Archive interop: Store, Deflate, Zstandard.\\n\".repeat(32)\n  let archive = @zip.read_all(bytes)\n  assert_eq(archive.get(\"payload.txt\"), Some(expected[:]))\n  let source = archive_range_source(bytes)\n  let directory = drive_directory_ranges(@zip.DirectoryReader(bytes.length().to_uint64()), source)\n  assert_eq(drive_entry_ranges(directory.open_entry(0), source, 1), expected)\n}\n")
  }
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(max_output_bytes=1 << 24)
  formatted.check()
  formatted.stdout()
}

async fn main {
  let program = python()
  if @env.args()[1:].contains("--check") {
    let files : Array[String] = []
    for line in @fs.read_text("zip/testdata/SHA256SUMS").split("\n") {
      if line.split("  ").to_array() is [expected, name] {
        guard name.has_suffix(".zip") && !name.contains("/") else { fail("unsafe fixture name") }
        guard sha256(program, "zip/testdata/\{name}") == expected.to_owned() else { fail("SHA-256 mismatch: \{name}") }
        files.push(name.to_owned())
      }
    }
    guard !files.is_empty() else { fail("empty fixture manifest") }
    guard source(files) == @fs.read_text("zip/src/interop_vectors_test.mbt") else { fail("stale embedded interop fixtures: run generator") }
    println("interop fixture hashes and embedded tests: OK (\{files.length()})")
    return
  }
  for dir in ["zip/testdata", "_build/interop-generation"] {
    if !@fs.exists(dir) { @fs.mkdir(dir, recursive=true) }
  }
  let directory = "_build/interop-generation"
  let file = "\{directory}/payload.txt"
  @fs.write_binary(file, payload)
  @fs.chmod(file, 0o644)
  @shell.Cmd("touch", ["-t", "202001020304.06", file], env={"TZ": "UTC"}).run()
  let produced : Array[String] = []
  let notes : Array[String] = []
  let version = @shell.Cmd(program, ["--version"]).output()
  notes.push(version.stdout().trim().to_owned())
  let supports_zstd = @shell.Cmd(program, ["-I", "-c", "import zipfile; raise SystemExit(0 if hasattr(zipfile,'ZIP_ZSTANDARD') else 1)"]).status() == 0
  for (name, code) in [("python-store.zip", "0"), ("python-deflate.zip", "8"), ("python-zstd.zip", "93")] {
    if code == "93" && !supports_zstd { notes.push("SKIP Python Zstandard: zipfile has no ZIP_ZSTANDARD"); continue }
    let path = "\{directory}/\{name}"
    @shell.Cmd(program, ["-I", "-c", python_zip, path, code], stdin=Binary(payload)).run()
    @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
    produced.push(name)
  }
  let zip_available = try { @shell.Cmd("zip", ["-v"]).output().check(); true } catch { _ => false }
  if zip_available {
    for (name, flags) in [("infozip-store.zip", "-0"), ("infozip-deflate.zip", "-9")] {
      let path = "\{directory}/\{name}"
      if @fs.exists(path) { @fs.remove(path) }
      let result = @shell.Cmd("zip", ["-X", "-D", "-q", flags, name, "payload.txt"], cwd=directory, env={"TZ": "UTC"}).output()
      result.check()
      @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
      produced.push(name)
    }
    notes.push(@shell.Cmd("zip", ["-v"]).output().stdout())
  } else { notes.push("SKIP Info-ZIP: zip command absent") }
  let seven = try { Some(@shell.Cmd("7z", ["i"]).output()) } catch { _ => None }
  if seven is Some(info) {
    info.check()
    notes.push(info.stdout())
    let zstd = info.stdout().split("\n").any(line => line.contains("ZSTD") || line.contains("Zstd"))
    for (name, codec_name) in [("7zip-deflate.zip", "Deflate"), ("7zip-zstd.zip", "ZSTD")] {
      if codec_name == "ZSTD" && !zstd { notes.push("SKIP 7-Zip Zstandard encoding: 7z i lists no ZSTD encoder"); continue }
      let path = "\{directory}/\{name}"
      if @fs.exists(path) { @fs.remove(path) }
      @shell.Cmd("7z", ["a", "-tzip", "-mm=\{codec_name}", "-mtc=off", "-mta=off", "-mtm=off", "-mmt=1", name, "payload.txt"], cwd=directory, env={"TZ": "UTC"}, stdout=Discard).run()
      @fs.write_binary("zip/testdata/\{name}", @fs.read_binary(path))
      produced.push(name)
    }
  } else { notes.push("SKIP 7-Zip: command absent") }
  let manifest : Array[String] = []
  for name in produced { manifest.push("\{sha256(program, "zip/testdata/\{name}")}  \{name}") }
  @fs.write_text("zip/testdata/SHA256SUMS", manifest.join("\n") + "\n")
  @fs.write_text("zip/testdata/PRODUCERS.txt", notes.join("\n") + "\n")
  @fs.write_text("zip/src/interop_vectors_test.mbt", source(produced))
  println("generated \{produced.length()} external ZIP fixtures")
}
