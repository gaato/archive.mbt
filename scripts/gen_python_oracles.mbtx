----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

// Python runs only during generation. --check verifies stored hashes and the
// generated tests without calling zipfile, so all four targets test the oracle
// data independently of the local Python version and installed codec support.
let oracle : String =
  #|import hashlib,io,json,sys,zipfile
  #|result=[]
  #|for item in json.load(sys.stdin):
  #|    raw=bytes.fromhex(item['archive'])
  #|    with zipfile.ZipFile(io.BytesIO(raw)) as z:
  #|        entries=[{'name':i.filename,'data':z.read(i).hex()} for i in z.infolist()]
  #|    result.append(dict(item,python=sys.version.split()[0],sha256=hashlib.sha256(raw).hexdigest(),entries=entries))
  #|print(json.dumps(result,ensure_ascii=False,indent=2))

let bindings : Array[(String, String)] = [
  ("zip/src/zip_test.mbt", "py_mini"),
  ("zip/src/zip_test.mbt", "py_zip64"),
  ("zip/src/zip_test.mbt", "py_descriptor"),
  ("zip/src/zip_test.mbt", "py_complex"),
  ("zip/src/zip_test.mbt", "optional_zip64"),
  ("zip/src/error_traits_test.mbt", "empty_archive"),
]

async fn fixtures() -> Array[(String, Bytes)] {
  // Every finite non-adversarial archive constant is catalogued. The one
  // deliberately lying ZIP64 fixture is an invalid-size regression instead.
  for file in @fs.readdir("zip/src") {
    if !file.has_suffix(".mbt") { continue }
    for line in @fs.read_text("zip/src/\{file}").split("\n") {
      if line.strip_prefix("let ") is Some(rest) && rest.split(" : Bytes =").to_array() is [name, _] {
        if file == "zip_test.mbt" && name == "lying_zip64" { continue }
        guard bindings.iter().any(pair => pair.0 == "zip/src/\{file}" && pair.1 == name.to_owned()) else {
          fail("uncatalogued archive constant: \{file}:\{name}")
        }
      }
    }
  }
  let script = StringBuilder()
  script.write_string("----\nimport { \"moonbitlang/core/encoding/hex\", }\n----\n")
  for (file, name) in bindings {
    let source = @fs.read_text(file)
    let start = source.find("let \{name} : Bytes =").unwrap()
    let rest = source[start:].to_owned()
    let end = rest.find("\n///|").unwrap_or(rest.length())
    script.write_string(rest[:end].to_owned() + "\n")
  }
  script.write_string("fn main {\n")
  for (_, name) in bindings {
    script.write_string("println(\"\{name} \" + @hex.encode(\{name}))\n")
  }
  script.write_string("}\n")
  @fs.write_text("_build/export_python_fixtures.mbtx", script.to_string())
  let result = @shell.Cmd("moon", ["run", "_build/export_python_fixtures.mbtx"]).output(max_output_bytes=1 << 24)
  result.check()
  let out : Array[(String, Bytes)] = []
  for line in result.stdout().split("\n") {
    if line.split(" ").to_array() is [name, hex] { out.push((name.to_owned(), @hex.decode(hex))) }
  }
  guard out.length() == bindings.length() else { fail("fixture export incomplete") }
  for line in @fs.read_text("zip/testdata/SHA256SUMS").split("\n") {
    if line.split("  ").to_array() is [_, name] {
      // CPython zipfile has no method-9 decoder. The Deflate64 fixtures have
      // independent expected data and 7-Zip validation in gen_interop.mbtx.
      if name.has_prefix("7zip-deflate64") { continue }
      out.push(("external/\{name}", @fs.read_binary("zip/testdata/\{name}")))
    }
  }
  // These survey cases are ordinary archives (including tolerated trailing
  // bytes and SFX). Decoys and the truncated comment have their own assertions
  // because their intended policy deliberately differs from Python's.
  for name in ["a_normal", "b_trailing_garbage", "c_trailing_zeros", "f_sfx_prefix_unadjusted", "f2_sfx_prefix_adjusted"] {
    out.push(("eocd-survey/\{name}.zip", @fs.read_binary("zip/testdata/eocd-survey/\{name}.zip")))
  }
  out
}

fn literal(hex : String) -> String {
  let parts : Array[String] = []
  for start = 0; start < hex.length(); start = start + 64 {
    let end = (start + 64).min(hex.length())
    let bytes : Array[String] = []
    for i = start; i < end; i = i + 2 { bytes.push("\\x" + hex[i:i + 2].to_owned()) }
    parts.push("b\"" + bytes.join("") + "\"")
  }
  if parts.is_empty() { "b\"\"" } else { parts.join(" +\n") }
}

async fn generated(records : Array[Json]) -> String {
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by scripts/gen_python_oracles.mbtx; Python zipfile names and contents.\n")
  for record in records {
    guard record is {"id": String(id), "archive": String(hex), "entries": Array(entries), ..} else { fail("invalid oracle record") }
    out.write_string("\n///|\ntest \"Python differential: \{id}\" {\nlet bytes =\n\{literal(hex)}\nlet expected : Array[(String, Bytes)] = [\n")
    for entry in entries {
      guard entry is {"name": String(name), "data": String(data), ..} else { fail("invalid entry oracle") }
      let name_json : Json = Json::string(name)
      out.write_string("(\{name_json.stringify()}, \{literal(data)}),\n")
    }
    out.write_string(" ]\nlet archive = @zip.read_all(bytes)\nlet source = archive_range_source(bytes)\nlet directory = drive_directory_ranges(@zip.DirectoryReader(bytes.length().to_uint64()), source)\nassert_eq(archive.entries().length(), expected.length())\nassert_eq(directory.entries().length(), expected.length())\nfor i, (name, data) in expected {\nassert_eq(archive.entries()[i].name(), name)\nassert_eq(archive.entries()[i].data(), data[:])\nassert_eq(directory.entries()[i].name(), name)\nassert_eq(drive_entry_ranges(directory.open_entry(i), source, 37), data)\n}\n}\n")
  }
  let result = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(max_output_bytes=1 << 24)
  result.check()
  result.stdout()
}

async fn main {
  if !@fs.exists("_build") { @fs.mkdir("_build") }
  let inputs = fixtures()
  let data_path = "zip/testdata/python-oracles.json"
  let test_path = "zip/src/python_oracles_test.mbt"
  if @env.args()[1:].contains("--check") {
    guard @json.parse(@fs.read_text(data_path)) is Array(records) else { fail("invalid oracle data") }
    guard records.length() == inputs.length() + 12 else { fail("oracle catalog count changed") }
    for (id, bytes) in inputs {
      guard records.iter().any(record => match record {
        {"id": String(name), "archive": String(hex), ..} => name == id && hex == @hex.encode(bytes)
        _ => false
      }) else { fail("stale fixture: \{id}") }
    }
    // hashlib is available even when the host zipfile cannot decode Zstandard.
    let hash_check = @shell.Cmd("python3", ["-I", "-c", "import json,hashlib,sys; r=json.load(open(sys.argv[1])); assert all(hashlib.sha256(bytes.fromhex(i['archive'])).hexdigest()==i['sha256'] for i in r)", data_path]).output()
    hash_check.check()
    guard generated(records) == @fs.read_text(test_path) else { fail("stale Python oracle tests") }
    println("Python differential oracle: \{records.length()} archives, hashes and generated tests OK")
    return
  }
  let written = @shell.Cmd("moon", ["run", "--target", "native", "zip/src/internal/interop"], env={"MOON_CC": @env.get_env_var("MOON_CC").unwrap_or("cc")}).output(max_output_bytes=1 << 24)
  written.check()
  for line in written.stdout().split("\n") {
    if line.split(" ").to_array() is [name, hex] { inputs.push(("written/\{name}", @hex.decode(hex))) }
  }
  let rows : Array[Json] = inputs.map(pair => {"id": pair.0, "archive": @hex.encode(pair.1)})
  let result = @shell.Cmd("python3.14", ["-I", "-c", oracle], stdin=Text(Json::array(rows).stringify())).output(max_output_bytes=1 << 24)
  if result.exit_code() != 0 { eprintln(result.stderr()); result.check() }
  guard @json.parse(result.stdout()) is Array(records) else { fail("invalid Python response") }
  @fs.write_text(data_path, result.stdout())
  @fs.write_text(test_path, generated(records))
  println("generated Python names/content oracles for \{records.length()} archives")
}
